#include "resource.h"
#include "afxres.h"
#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_YTDLPGUI_DIALOG DIALOGEX 0, 0, 360, 316
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "yt-dlp 下载器"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "搜索:",IDC_STATIC,7,9,26,8
    EDITTEXT        IDC_EDIT_SEARCH,36,7,172,13,ES_AUTOHSCROLL
    LTEXT           "数量:",IDC_STATIC,214,9,22,8
    COMBOBOX        IDC_COMBO_COUNT,238,7,44,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "搜索",IDC_BTN_SEARCH,288,7,65,13

    CONTROL         "",IDC_LIST_RESULTS,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,7,24,346,66

    LTEXT           "视频链接 (每行一个；搜索结果可勾选或双击添加):",IDC_STATIC,7,96,240,8
    AUTOCHECKBOX    "全选搜索结果",IDC_CHECK_ALL,270,95,83,10
    EDITTEXT        IDC_EDIT_URLS,7,106,346,34,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL

    LTEXT           "保存到:",IDC_STATIC,7,148,30,8
    EDITTEXT        IDC_EDIT_SAVEDIR,42,145,240,13,ES_AUTOHSCROLL
    PUSHBUTTON      "浏览...",IDC_BTN_BROWSE_SAVE,288,145,65,13

    LTEXT           "下载类型:",IDC_STATIC,7,166,36,8
    COMBOBOX        IDC_COMBO_FORMAT,46,163,160,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "不下载整个播放列表",IDC_CHECK_NOPLAYLIST,216,165,110,10

    LTEXT           "代理:",IDC_STATIC,7,184,22,8
    EDITTEXT        IDC_EDIT_PROXY,32,181,150,13,ES_AUTOHSCROLL
    LTEXT           "Cookies:",IDC_STATIC,192,184,34,8
    COMBOBOX        IDC_COMBO_COOKIES,228,181,90,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "开始下载",IDC_BTN_START,7,202,70,16
    PUSHBUTTON      "停止",IDC_BTN_STOP,82,202,50,16
    PUSHBUTTON      "打开保存目录",IDC_BTN_OPENDIR,137,202,70,16

    CONTROL         "",IDC_PROGRESS,"msctls_progress32",WS_BORDER,7,224,346,10
    LTEXT           "就绪",IDC_STATIC_STATUS,7,237,346,8
    EDITTEXT        IDC_EDIT_LOG,7,248,346,62,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
END
